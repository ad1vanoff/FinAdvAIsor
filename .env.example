# Copy to .env (never commit it). The server reads this file on start.
ANTHROPIC_API_KEY=sk-ant-...
# Cheap, fast default. Any current Claude model id works.
ASSISTANT_MODEL=claude-sonnet-5
# Let the assistant search the web for extra references (costs more per answer).
ASSISTANT_WEB_SEARCH=0
# Stream canned replies without a key, for UI work.
ASSISTANT_MOCK=0
PORT=8791
